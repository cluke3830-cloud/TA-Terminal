# ─────────────────────────────────────────────
#  TA Terminal — Environment Variables
#  Copy this file to .env.local and fill in your keys.
#  Never commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────

# ── Optional self-hosted services ────────────
# Leave these empty unless you run the Python services in this repository.
# REGIME_API_URL: regime-service (the /regime page)
# MC_GPU_URL:     gpu-service (FinBERT news scoring, GPU Monte Carlo)
# LLM_REGIME_URL: gpu-service LLM endpoint (plain-language regime summary)
REGIME_API_URL=
MC_GPU_URL=
LLM_REGIME_URL=

# ── Financial Modeling Prep ──────────────────
# Used for 13F institutional ownership data (optional — Yahoo Finance fallback is active)
# Free tier: 250 requests/day   Paid: https://site.financialmodelingprep.com/developer/docs/pricing
# Get key: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# ── FRED (Federal Reserve Economic Data) ────
# Optional. Only a fallback for the risk-free rate when the US Treasury site
# is down; the yield curve, fed funds and CPI need no key.
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── EIA (U.S. Energy Information Administration) ─
# Used for the oil reserves map and the electricity price on the macro page
# Free API — no credit card required
# Get key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── Alpaca Markets ───────────────────────────
# Used for real-time quotes and options data
# Free paper trading account works for market data
# Get key: https://app.alpaca.markets/signup
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Anthropic (Claude) ───────────────────────
# Used for AI-powered analysis features (optional)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Google Gemini ────────────────────────────
# Powers the AI Analyst drawer (top-bar ✦ AI button) with Google Search grounding.
# Free tier: 15 requests/min, 1500 requests/day on gemini-2.5-flash.
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── OpenSky Network ──────────────────────────
# Used for live flight/cargo data (macro page)
# Free account — register at: https://opensky-network.org/index.php?option=com_users&view=registration
OPENSKY_USERNAME=
OPENSKY_PASSWORD=